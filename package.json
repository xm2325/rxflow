{
  "name": "rxflow",
  "version": "0.5.0",
  "private": true,
  "description": "AI-assisted specialty pharmacy workflow platform using synthetic FHIR events.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "start": "npm run build && node dist/src/server.js",
    "start:consumer": "npm run build && node dist/src/consumer-server.js",
    "start:worker": "npm run build && node dist/src/worker-server.js",
    "check": "npm run test && npm run demo && npm run eval:ai",
    "demo:events": "npm run build && node dist/src/event-demo.js",
    "eval:ai": "npm run build && node dist/src/run-ai-eval.js",
    "benchmark": "npm run build && node dist/src/benchmark.js",
    "benchmark:outbox": "npm run build && node dist/src/outbox-benchmark.js",
    "check:docs": "npm run build && node dist/src/docs-check.js",
    "release:check": "node scripts/release-check.mjs",
    "outbox:drain": "npm run build && node dist/src/run-outbox-once.js",
    "test:postgres:live": "npm run build && node integration/postgres-live.mjs",
    "db:migrate": "npm run build && node dist/src/migrate-postgres.js",
    "check:api": "npm run build && node dist/src/api-contract-check.js",
    "test:http:smoke": "npm run build && node integration/http-smoke.mjs",
    "test:worker:smoke": "npm run build && node integration/external-worker-smoke.mjs",
    "test:worker:multi": "npm run build && node integration/multi-process-worker-smoke.mjs",
    "test:worker:crash": "npm run build && node integration/worker-crash-recovery.mjs",
    "demo:smart": "npm run build && node dist/src/smart-demo.js",
    "check:infra": "npm run build && node dist/src/infra-contract-check.js",
    "test:worker:lease": "npm run build && node integration/slow-delivery-lease-smoke.mjs",
    "test:worker:shutdown": "npm run build && node integration/worker-graceful-shutdown.mjs",
    "test:worker:outage": "npm run build && node integration/systemic-outage-smoke.mjs",
    "test:worker:fairness": "npm run build && node integration/tenant-fairness-smoke.mjs",
    "test:worker:tenant-throttle": "npm run build && node integration/tenant-throttle-smoke.mjs",
    "test:queue:age": "npm run build && node integration/queue-age-smoke.mjs",
    "test:worker:late-arrival": "npm run build && node integration/late-arrival-fairness-smoke.mjs",
    "test:worker:aggregate-order": "npm run build && node integration/aggregate-ordering-smoke.mjs",
    "test:worker:aggregate-retirement": "npm run build && node integration/aggregate-retirement-smoke.mjs",
    "test:worker:tenant-concurrency": "npm run build && node integration/slow-tenant-concurrency-smoke.mjs",
    "test:worker:global-concurrency": "npm run build && node integration/global-outage-concurrency-smoke.mjs",
    "check:dashboard": "node integration/dashboard-contract.mjs",
    "test:coverage:core": "npm run build && node --experimental-test-coverage --test-coverage-include='dist/src/*.js' --test-coverage-exclude='dist/src/*-server.js' --test-coverage-exclude='dist/src/*-demo.js' --test-coverage-exclude='dist/src/*-check.js' --test-coverage-exclude='dist/src/run-*.js' --test-coverage-exclude='dist/src/*benchmark.js' --test-coverage-exclude='dist/src/postgres-store.js' --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test dist/test/*.test.js",
    "test:http:request-boundary": "npm run build && node integration/request-boundary-smoke.mjs",
    "doctor": "node scripts/repo-doctor.mjs",
    "test:coverage:core:compiled": "node --experimental-test-coverage --test-coverage-include='dist/src/*.js' --test-coverage-exclude='dist/src/*-server.js' --test-coverage-exclude='dist/src/*-demo.js' --test-coverage-exclude='dist/src/*-check.js' --test-coverage-exclude='dist/src/run-*.js' --test-coverage-exclude='dist/src/*benchmark.js' --test-coverage-exclude='dist/src/postgres-store.js' --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test dist/test/*.test.js",
    "check:ci": "npm run build && node dist/src/ci-contract-check.js",
    "check:dependencies": "npm run build && node dist/src/dependency-lock-check.js",
    "check:repo": "npm run build && node dist/src/repository-hygiene-check.js",
    "check:surface": "npm run build && node dist/src/public-surface-check.js",
    "check:operational-errors": "npm run build && node dist/src/operational-error-contract-check.js",
    "demo:evidence": "npm run build && node integration/evidence-demo.mjs",
    "check:evidence": "npm run build && node dist/src/evidence-boundaries-check.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
